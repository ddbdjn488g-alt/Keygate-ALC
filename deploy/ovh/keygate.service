[Unit]
Description=Keygate license server (ALC)
Documentation=file:///opt/keygate/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=keygate
Group=keygate
WorkingDirectory=/opt/keygate/current
# Secrets live outside the release and outside Git; systemd reads the file as root.
EnvironmentFile=/etc/keygate/keygate.env
ExecStart=/opt/keygate/current/keygate
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening: the server only needs the network and read access to its release.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitNOFILE=65536
MemoryMax=1500M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=keygate

[Install]
WantedBy=multi-user.target
