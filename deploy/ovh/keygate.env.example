# /etc/keygate/keygate.env  (root:root 0600) - generated by bootstrap.sh, NEVER commit the real file.
PORT=9000
ENVIRONMENT=production
BASE_URL=https://api.alc-control.com

# Local PostgreSQL (127.0.0.1 only); the password is generated by bootstrap.sh.
DATABASE_URL=postgres://keygate:<generated>@127.0.0.1:5432/keygate?sslmode=disable

# Generated by bootstrap.sh (openssl rand -hex 32). LICENSE_SIGNING_KEY signs the license proofs (Ed25519 seed):
# the matching PUBLIC key is what ALC pins. RELEASE_KEY_ENCRYPTION_KEY encrypts license keys at rest:
# losing either makes the backups of the database unusable - keep the encrypted backup of this file.
JWT_SECRET=<generated>
LICENSE_SIGNING_KEY=<generated>
RELEASE_KEY_ENCRYPTION_KEY=<generated>

# Admin login codes are sent to these addresses.
ADMIN_EMAILS=contact@alc-control.com

# Keygate sits behind Caddy on this host (loopback): believe its X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Key format of the ALC product (real product id, set once the product exists in this instance).
ALC_KEY_PRODUCT_IDS=

# OVH mailbox (see README.md; the password is entered with set-secret.sh, never in this file by hand).
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=587
SMTP_USERNAME=contact@alc-control.com
SMTP_FROM=Autotune Live Control <contact@alc-control.com>
SMTP_PASSWORD=

# Stripe stays OFF until enabled on purpose (test key only). Enabling it makes THIS server create its own,
# separate webhook endpoint in the Stripe account; Blitz keeps its own.
#STRIPE_SECRET_KEY=sk_test_...
